    <path android:pathData="M22,54a32,32 0,1 1,64 0a32,32 0,1 1,-64 0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="32"
